# ==============================================================
# UMKMku — Environment Variables Example
# Salin file ini ke .env dan isi nilainya.
# JANGAN pernah commit file .env ke git.
# ==============================================================

# ----- PostgreSQL -----
POSTGRES_USER=umkm_user
POSTGRES_PASSWORD=ganti_password_kuat_di_sini
POSTGRES_DB=umkm_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://umkm_user:ganti_password_kuat_di_sini@localhost:5432/umkm_db

# ----- Redis -----
REDIS_PORT=6379
REDIS_PASSWORD=ganti_redis_password
REDIS_URL=redis://:ganti_redis_password@localhost:6379

# ----- MinIO (S3-compatible object storage lokal) -----
MINIO_ROOT_USER=umkm_minio
MINIO_ROOT_PASSWORD=ganti_minio_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=umkm-uploads
MINIO_ACCESS_KEY=ganti_access_key
MINIO_SECRET_KEY=ganti_secret_key

# ----- JWT -----
JWT_ACCESS_SECRET=ganti_dengan_string_acak_min_64_karakter
JWT_REFRESH_SECRET=ganti_dengan_string_acak_berbeda_min_64_karakter
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- App -----
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----- Payment Gateway (Midtrans) -----
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_URL=http://localhost:3001/api/payments/webhook/midtrans

# ----- Payment Gateway (Xendit) — alternatif -----
XENDIT_SECRET_KEY=xnd_development_xxxxxx
XENDIT_WEBHOOK_VERIFICATION_TOKEN=ganti_xendit_webhook_token

# ----- Shipping (Biteship) -----
BITESHIP_API_KEY=biteship-sandbox-xxxxxx

# ----- Email (SMTP) -----
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=ganti_smtp_user
SMTP_PASS=ganti_smtp_pass
SMTP_FROM=noreply@umkmku.id

# ----- AWS S3 (untuk production, gantikan MinIO) -----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=umkm-marketplace-prod

# ----- Cloudflare R2 (alternatif S3) -----
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=umkm-uploads
# R2_PUBLIC_URL=https://pub-xxx.r2.dev
