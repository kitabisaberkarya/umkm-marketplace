# Salin ke .env dan isi nilainya
DATABASE_URL=postgresql://umkm_user:umkm_password@localhost:5432/umkm_db
REDIS_URL=redis://:umkm_redis_pass@localhost:6379
APP_PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

JWT_ACCESS_SECRET=ganti_dengan_string_acak_min_64_karakter_untuk_access_token_ya
JWT_REFRESH_SECRET=ganti_dengan_string_acak_min_64_karakter_untuk_refresh_token_ya
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=ganti_access_key
MINIO_SECRET_KEY=ganti_secret_key
MINIO_BUCKET_NAME=umkm-uploads

MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxx
MIDTRANS_IS_PRODUCTION=false

BITESHIP_API_KEY=biteship-sandbox-xxxxxx

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@umkmku.id
